echo "[pre-push] Running npm audit (blocking on high/critical)..."

AUDIT_LOG=$(mktemp)

if npm audit --audit-level=high >"$AUDIT_LOG" 2>&1; then
  echo "[pre-push] npm audit: no high/critical vulnerabilities. Proceeding."
  rm -f "$AUDIT_LOG"
  exit 0
fi

cat "$AUDIT_LOG"
echo ""
echo "[pre-push] High/critical vulnerabilities found. Attempting 'npm audit fix'..."
echo ""

FIX_LOG=$(mktemp)
npm audit fix >"$FIX_LOG" 2>&1
cat "$FIX_LOG"
rm -f "$FIX_LOG"

if npm audit --audit-level=high >"$AUDIT_LOG" 2>&1; then
  echo ""
  echo "[pre-push] BLOCKED: 'npm audit fix' resolved the remaining issues, but"
  echo "package-lock.json (and possibly package.json) changed as a result and"
  echo "is NOT part of this push yet. Review, commit, then push again:"
  echo ""
  echo "    git add package.json package-lock.json"
  echo "    git commit -m \"fix: npm audit vulnerabilities\""
  echo "    git push"
  rm -f "$AUDIT_LOG"
  exit 1
fi

cat "$AUDIT_LOG"
rm -f "$AUDIT_LOG"
echo ""
echo "[pre-push] BLOCKED: high/critical vulnerabilities remain that 'npm audit fix'"
echo "could not resolve automatically (they likely require a breaking upgrade)."
echo ""
echo "Next steps:"
echo "  1. Run 'npm audit' to see full advisory details."
echo "  2. Try 'npm audit fix --force' on a branch, then run:"
echo "       npm run lint && npm run typecheck && npm run build"
echo "     to confirm nothing broke before committing."
echo "  3. If no fix is available yet upstream, document the exception"
echo "     (package, advisory, why it can't be fixed) and get sign-off"
echo "     before pushing with 'git push --no-verify'."
exit 1
